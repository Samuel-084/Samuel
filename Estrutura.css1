* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    padding: 10px;
    min-height: 100vh;
    display: grid;
    gap: 10px;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: 200px 1fr;
}

header {
    grid-column: 1 / -1;
    background-color: #ff5722;
    color: white;
    padding: 20px;
    text-align: center;
    border-radius: 5px;
}

nav {
    grid-column: 1;
    background-color: #333;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    border-radius: 5px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

main {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

section {
    background-color: white;
    padding: 20px;
    border: 2px solid #ddd;
    border-radius: 5px;
    min-height: 150px;
}

article {
    margin-top: 15px;
    padding: 10px;
    background-color: #fafafa;
    border-left: 4px solid #ff5722;
}

footer {
    grid-column: 1 / -1;
    background-color: #222;
    color: white;
    text-align: center;
    padding: 15px;
    border-radius: 5px;
}
